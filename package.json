{
  "name": "codex-multi-tab",
  "displayName": "Codex Multi Tab",
  "description": "独立 Codex 多 Tab 与分屏，按项目管理会话，查看官方账号用量及重置时间。",
  "version": "0.4.4",
  "icon": "assets/icon.png",
  "publisher": "mofyer",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mofyer/codex-multi-tab.git"
  },
  "homepage": "https://github.com/mofyer/codex-multi-tab#readme",
  "bugs": {
    "url": "https://github.com/mofyer/codex-multi-tab/issues"
  },
  "engines": {
    "vscode": "^1.96.2"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "codex",
    "multi-tab",
    "chat",
    "history"
  ],
  "extensionKind": [
    "ui"
  ],
  "extensionDependencies": [
    "openai.chatgpt"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:codexMultiTab.sidebar"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codexMultiTab.newTab",
        "title": "Codex：新建独立标签页",
        "shortTitle": "新建 Codex",
        "icon": {
          "light": "assets/toolbar-icon.png",
          "dark": "assets/toolbar-icon.png"
        }
      },
      {
        "command": "codexMultiTab.newTabBeside",
        "title": "Codex：在右侧新建独立标签页"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "codexMultiTab.newTab",
          "group": "navigation@99"
        }
      ],
      "view/title": [
        {
          "command": "codexMultiTab.newTab",
          "when": "view == chatgpt.sidebarView || view == chatgpt.sidebarSecondaryView",
          "group": "navigation@99"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codexMultiTab.newTab",
        "key": "ctrl+alt+shift+n",
        "mac": "cmd+alt+shift+n"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexMultiTab",
          "title": "Codex Multi Tab",
          "icon": "assets/toolbar-icon.png"
        }
      ]
    },
    "views": {
      "codexMultiTab": [
        {
          "id": "codexMultiTab.sidebar",
          "name": "Codex Multi Tab",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "check": "node scripts/check.js",
    "test": "node --test test/*.test.js",
    "title:check": "node title-patch.js dry-run",
    "title:apply": "node title-patch.js apply",
    "title:restore": "node title-patch.js restore",
    "package": "npm run check && npm test && node scripts/package.js"
  }
}
